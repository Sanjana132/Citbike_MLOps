# Airflow image with the project's ML dependencies layered on top.
#
# Airflow pins a large dependency tree via its constraint file, so project
# packages are installed against that constraint set to avoid a resolver
# fight that would break the scheduler.
FROM apache/airflow:2.10.5-python3.11

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
USER airflow

# CPU-only torch: the LSTM trains fine on CPU and the CUDA wheels would add
# several gigabytes to the image for nothing.
RUN pip install --no-cache-dir \
    torch==2.13.0 --index-url https://download.pytorch.org/whl/cpu

COPY docker/requirements-airflow.txt /tmp/requirements-airflow.txt
RUN pip install --no-cache-dir -r /tmp/requirements-airflow.txt

ENV PYTHONPATH=/opt/airflow
