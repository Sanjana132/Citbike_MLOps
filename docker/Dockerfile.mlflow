# MLflow tracking server with a Postgres backend store.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Pinned to match the client version in requirements.txt - a server/client
# mismatch surfaces as confusing registry errors.
RUN pip install --no-cache-dir mlflow==2.22.5 psycopg2-binary==2.9.12 boto3==1.42.15

RUN mkdir -p /mlflow/artifacts

EXPOSE 5000

# --serve-artifacts proxies artifact download through the server, so clients
# (API, Airflow) do not need to share the artifact volume.
CMD ["sh", "-c", "mlflow server \
    --host 0.0.0.0 --port 5000 \
    --backend-store-uri ${MLFLOW_BACKEND_STORE_URI} \
    --artifacts-destination ${MLFLOW_ARTIFACT_ROOT} \
    --serve-artifacts"]
