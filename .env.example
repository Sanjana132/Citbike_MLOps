# Copy to .env and adjust. NEVER commit the real .env - it is gitignored.

# ---------------------------------------------------------------------------
# Postgres (feature/data store)
# ---------------------------------------------------------------------------
POSTGRES_USER=citibike
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=citibike
POSTGRES_PORT=5432

# Consumed by src/storage/db.py. Inside the compose network the host is
# "postgres"; from your laptop use "localhost".
DATABASE_URL=postgresql+psycopg2://citibike:change-me-in-production@postgres:5432/citibike

# ---------------------------------------------------------------------------
# MLflow
# ---------------------------------------------------------------------------
# Leave unset to fall back to a local ./mlruns file store (fine for M1).
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_PORT=5001
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://citibike:change-me-in-production@postgres:5432/mlflow
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change-me-in-production
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=

# ---------------------------------------------------------------------------
# Application services
# ---------------------------------------------------------------------------
API_PORT=8000
DASHBOARD_PORT=8501

# ---------------------------------------------------------------------------
# Optional third-party keys
# ---------------------------------------------------------------------------
# Only needed if you switch weather.live_provider to "openweather".
# The default path (Open-Meteo archive + NOAA live) requires no key at all.
OPENWEATHER_API_KEY=

# Override the config file location (used by tests and by the containers).
# CITIBIKE_CONFIG=/opt/airflow/config/config.yaml
